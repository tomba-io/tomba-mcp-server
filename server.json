{
    "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
    "name": "io.github.tomba-io/tomba-mcp-server",
    "title": "Tomba MCP Server",
    "description": "MCP server for Tomba Find, verify and enrich every B2B contact API",
    "websiteUrl": "https://tomba.io",
    "repository": {
        "url": "https://github.com/tomba-io/tomba-mcp-server",
        "source": "github"
    },
    "version": "1.10.0",
    "packages": [
        {
            "registryType": "npm",
            "identifier": "@tomba-io/tomba-mcp-server",
            "version": "1.10.0",
            "runtimeHint": "npx",
            "transport": {
                "type": "stdio"
            },
            "environmentVariables": [
                {
                    "name": "TOMBA_API_KEY",
                    "description": "Tomba API key (format: ta_*)",
                    "isRequired": true,
                    "isSecret": true
                },
                {
                    "name": "TOMBA_SECRET_KEY",
                    "description": "Tomba secret key (format: ts_*)",
                    "isRequired": true,
                    "isSecret": true
                }
            ]
        }
    ],
    "remotes": [
        {
            "type": "streamable-http",
            "url": "https://mcp.tomba.io/mcp",
            "headers": [
                {
                    "name": "X-Tomba-Key",
                    "description": "Tomba API key (ta_...). Optional: OAuth is used when no credentials are sent",
                    "value": "{api_key}",
                    "isRequired": false,
                    "isSecret": true,
                    "variables": {
                        "api_key": {
                            "description": "Tomba API key (format: ta_*)",
                            "isRequired": true,
                            "isSecret": true
                        }
                    }
                },
                {
                    "name": "X-Tomba-Secret",
                    "description": "Tomba secret key (ts_...). Use together with X-Tomba-Key",
                    "value": "{secret_key}",
                    "isRequired": false,
                    "isSecret": true,
                    "variables": {
                        "secret_key": {
                            "description": "Tomba secret key (format: ts_*)",
                            "isRequired": true,
                            "isSecret": true
                        }
                    }
                },
                {
                    "name": "Authorization",
                    "description": "Optional alternative to X-Tomba-Key/X-Tomba-Secret: Bearer base64(ta_key:ts_secret). Omit all headers to sign in with OAuth (no keys needed)",
                    "value": "Bearer {credentials}",
                    "isRequired": false,
                    "isSecret": true,
                    "variables": {
                        "credentials": {
                            "description": "Base64 encoded API credentials (ta_key:ts_secret)",
                            "isRequired": true,
                            "isSecret": true
                        }
                    }
                }
            ]
        }
    ]
}
